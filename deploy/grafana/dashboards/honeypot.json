      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"honeypot\", event=\"request\", waf_flagged=\"false\"} | json | trap != \"portal-login\" | line_format \"{{.client}} {{.method}} {{.uri}} [{{.trap}}] {{.ua}} {{.body}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 13,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "type": "logs",
