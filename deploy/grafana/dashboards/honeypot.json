          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"honeypot\", event=\"request\", waf_flagged=\"true\"} | json | line_format \"{{.client}} {{.method}} {{.uri}} rules={{.waf_rules}} score={{.waf_score}} id={{.waf_request_id}}\""
